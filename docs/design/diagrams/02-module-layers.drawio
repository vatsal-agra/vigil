<mxCell id="module-layers-sub" value="Each box is one file with one job. Dependencies point downward only; no module imports from a layer above it." style="text;html=1;fontSize=13;fontColor=#79818D;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="52" width="1340" height="22" as="geometry"/></mxCell>
