<mxCell id="r1" value="owns" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERmany;startArrow=ERmandOne;endFill=0;startFill=0;strokeColor=#3F4650;strokeWidth=1.5;fontSize=11;fontColor=#3F4650;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="users-0" target="monitors-1"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="r2" value="records" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERmany;startArrow=ERmandOne;endFill=0;startFill=0;strokeColor=#3F4650;strokeWidth=1.5;fontSize=11;fontColor=#3F4650;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="monitors-0" target="checks-1"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="r3" value="opens" style="edgeStyle=entityRelationEdgeStyle;html=1;endArrow=ERmany;startArrow=ERmandOne;endFill=0;startFill=0;strokeColor=#3F4650;strokeWidth=1.5;fontSize=11;fontColor=#3F4650;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="monitors-0" target="incidents-1"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="note" value="&lt;b&gt;Why this shape.&lt;/b&gt; checks is the only table that grows without bound (about 1,440 rows per monitor per day at 60 s), so both monitor_id and checked_at are indexed and nothing joins across it on the hot path: the dashboard reads a pre-aggregated rollup from Redis. Incident state is derived from resolved_at IS NULL, so there is no separate status column to drift out of sync." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#D5DAE1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=12;fontSize=12;fontColor=#3F4650;" vertex="1" parent="1"><mxGeometry x="40" y="470" width="700" height="84" as="geometry"/></mxCell>
