<mxCell id="data-model-title" value="Vigil - Data Model (PostgreSQL)" style="text;html=1;fontSize=24;fontStyle=1;fontColor=#12161C;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="18" width="1180" height="34" as="geometry"/></mxCell>
<mxCell id="data-model-sub" value="Four tables. Every monitor belongs to exactly one user; checks and incidents cascade-delete with their monitor." style="text;html=1;fontSize=13;fontColor=#79818D;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="52" width="1180" height="22" as="geometry"/></mxCell>
