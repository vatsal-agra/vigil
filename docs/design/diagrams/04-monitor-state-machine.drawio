<mxfile host="app.diagrams.net" type="device">
<diagram id="state-machine" name="Vigil - Monitor State Machine">
<mxGraphModel dx="1300" dy="760" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1300" pageHeight="760" background="#FFFFFF" math="0" shadow="0">
<root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="state-machine-title" value="Vigil - Monitor Status and Incident Lifecycle" style="text;html=1;fontSize=24;fontStyle=1;fontColor=#12161C;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="18" width="1240" height="34" as="geometry"/></mxCell>
<mxCell id="state-machine-sub" value="Implemented in app/probe.py apply_result(). failure_threshold = 2 (config.py), slow = latency above 2000 ms." style="text;html=1;fontSize=13;fontColor=#79818D;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="30" y="52" width="1240" height="22" as="geometry"/></mxCell>
<mxCell id="start" value="" style="ellipse;html=1;fillColor=#12161C;strokeColor=#12161C;" vertex="1" parent="1"><mxGeometry x="90" y="330" width="26" height="26" as="geometry"/></mxCell>
<mxCell id="pending" value="&lt;b style=&#x27;font-size:15px&#x27;&gt;pending&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;color:#79818D&#x27;&gt;created, never checked&lt;/span&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#79818D;strokeWidth=2.5;fontColor=#79818D;" vertex="1" parent="1"><mxGeometry x="170" y="308" width="190" height="70" as="geometry"/></mxCell>
<mxCell id="up" value="&lt;b style=&#x27;font-size:15px&#x27;&gt;up&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;color:#79818D&#x27;&gt;last check ok, fast&lt;/span&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#E9F6F1;strokeColor=#0E7C5A;strokeWidth=2.5;fontColor=#0E7C5A;" vertex="1" parent="1"><mxGeometry x="560" y="130" width="190" height="70" as="geometry"/></mxCell>
<mxCell id="degraded" value="&lt;b style=&#x27;font-size:15px&#x27;&gt;degraded&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;color:#79818D&#x27;&gt;ok but &gt; 2000 ms&lt;/span&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#FBF4E3;strokeColor=#B8860B;strokeWidth=2.5;fontColor=#B8860B;" vertex="1" parent="1"><mxGeometry x="560" y="500" width="190" height="70" as="geometry"/></mxCell>
<mxCell id="down" value="&lt;b style=&#x27;font-size:15px&#x27;&gt;down&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:10px;color:#79818D&#x27;&gt;incident OPEN&lt;/span&gt;" style="rounded=1;arcSize=40;whiteSpace=wrap;html=1;fillColor=#FBEDEB;strokeColor=#C0392B;strokeWidth=2.5;fontColor=#C0392B;" vertex="1" parent="1"><mxGeometry x="980" y="308" width="190" height="70" as="geometry"/></mxCell>
<mxCell id="t0" value="" style="html=1;endArrow=block;endFill=1;strokeColor=#3F4650;strokeWidth=1.5;fontSize=11;fontColor=#3F4650;labelBackgroundColor=#FFFFFF;curved=1;" edge="1" parent="1" source="start" target="pending"><mxGeometry x="0" relative="1" as="geometry"></mxGeometry></mxCell>
<mxCell id="t1" value="check ok, fast" style="html=1;endArrow=block;endFill=1;strokeColor=#3F4650;strokeWidth=1.5;fontSize=11;fontColor=#3F4650;labelBackgroundColor=#FFFFFF;curved=1;" edge="1" parent="1" source="pending" target="up"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="330" y="200"/></Array></mxGeometry></mxCell>
<mxCell id="t2" value="check ok, slow" style="html=1;endArrow=block;endFill=1;strokeColor=#3F4650;strokeWidth=1.5;fontSize=11;fontColor=#3F4650;labelBackgroundColor=#FFFFFF;curved=1;" edge="1" parent="1" source="pending" target="degraded"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="330" y="500"/></Array></mxGeometry></mxCell>
<mxCell id="t3" value="latency &gt; 2 s" style="html=1;endArrow=block;endFill=1;strokeColor=#3F4650;strokeWidth=1.5;fontSize=11;fontColor=#3F4650;labelBackgroundColor=#FFFFFF;curved=1;" edge="1" parent="1" source="up" target="degraded"><mxGeometry x="-0.55" relative="1" as="geometry"><Array as="points"><mxPoint x="620" y="360"/></Array></mxGeometry></mxCell>
<mxCell id="t4" value="latency &lt; 2 s" style="html=1;endArrow=block;endFill=1;strokeColor=#3F4650;strokeWidth=1.5;fontSize=11;fontColor=#3F4650;labelBackgroundColor=#FFFFFF;curved=1;" edge="1" parent="1" source="degraded" target="up"><mxGeometry x="-0.55" relative="1" as="geometry"><Array as="points"><mxPoint x="690" y="360"/></Array></mxGeometry></mxCell>
<mxCell id="t5" value="2nd consecutive failure
=&gt; open Incident" style="html=1;endArrow=block;endFill=1;strokeColor=#C0392B;strokeWidth=1.5;fontSize=11;fontColor=#3F4650;labelBackgroundColor=#FFFFFF;curved=1;" edge="1" parent="1" source="up" target="down"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="1000" y="190"/></Array></mxGeometry></mxCell>
<mxCell id="t6" value="2nd consecutive failure
=&gt; open Incident" style="html=1;endArrow=block;endFill=1;strokeColor=#C0392B;strokeWidth=1.5;fontSize=11;fontColor=#3F4650;labelBackgroundColor=#FFFFFF;curved=1;" edge="1" parent="1" source="degraded" target="down"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="1000" y="530"/></Array></mxGeometry></mxCell>
<mxCell id="t7" value="first success
=&gt; resolve + write summary" style="html=1;endArrow=block;endFill=1;strokeColor=#0E7C5A;strokeWidth=1.5;fontSize=11;fontColor=#3F4650;labelBackgroundColor=#FFFFFF;curved=1;" edge="1" parent="1" source="down" target="up"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="870" y="290"/></Array></mxGeometry></mxCell>
<mxCell id="t8" value="2 failures before any success" style="html=1;endArrow=block;endFill=1;strokeColor=#C0392B;strokeWidth=1.5;fontSize=11;fontColor=#3F4650;labelBackgroundColor=#FFFFFF;curved=1;" edge="1" parent="1" source="pending" target="down"><mxGeometry x="0" relative="1" as="geometry"><Array as="points"><mxPoint x="620" y="330"/></Array></mxGeometry></mxCell>
<mxCell id="self" value="1st failure: consecutive_failures = 1, status unchanged. One bad check is noise, not an incident (flap guard, US-13)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#D5DAE1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;fontSize=12;fontColor=#3F4650;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="560" height="60" as="geometry"/></mxCell>
<mxCell id="inv" value="Every transition ends with commit, then cache.invalidate() on the owner&#x27;s list, the monitor&#x27;s series and every public status page." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F6F8;strokeColor=#D5DAE1;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;fontSize=12;fontColor=#3F4650;" vertex="1" parent="1"><mxGeometry x="650" y="620" width="600" height="60" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>
