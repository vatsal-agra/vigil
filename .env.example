# Copy to .env before running `docker compose up`.
# docker-compose.yml has sane defaults for all of these, so .env is optional locally.

POSTGRES_USER=vigil
POSTGRES_PASSWORD=vigil
POSTGRES_DB=vigil

# Generate a real one:  openssl rand -hex 32
JWT_SECRET=dev-secret-change-me

# Build targets: dev (hot reload) or prod (optimised images)
BACKEND_TARGET=dev
FRONTEND_TARGET=dev

# Browser-visible API address
NEXT_PUBLIC_API_URL=http://localhost:8000
